# ───────────────────────────────────────────────────────────────
# Enphera Compendium — environment variables
# Copy this file to `.env` (or `.env.local` for local dev) and fill in real values.
# ───────────────────────────────────────────────────────────────

# Path to the SQLite database file. Use an absolute path on the host so the
# file persists across restarts. On Railway/Render/Fly, point this at a path
# inside your mounted persistent volume (e.g. /data/enphera.db).
DATABASE_URL=file:./db/enphera.db

# Admin PIN — change this before deploying. 4–8 digits.
ADMIN_PIN=1234

# Secret used to encrypt the admin session cookie.
# Generate a long random string: `openssl rand -hex 32` or `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters

# Cookie name (optional, defaults to enphera_admin_session).
SESSION_COOKIE_NAME=enphera_admin_session

# Directory where markdown chapter files live.
# Defaults to `<project root>/content` (works for local dev and VPS).
# On Railway/Render/Fly: set this to a path inside your persistent volume so
# uploaded chapters survive redeploys — e.g. CONTENT_DIR=/data/content
# CONTENT_DIR=/data/content

# Set to production when deploying.
NODE_ENV=production
